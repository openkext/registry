{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openkext.org/schema/report.schema.json",
  "title": "OpenKext test report (kexts/<id>/reports/<login>/<name>.toml)",
  "description": "Schema of a test report, expressed as JSON. The files are TOML; openkext_registry/model.py is the authoritative check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kext",
    "version",
    "result",
    "date",
    "macos",
    "hardware"
  ],
  "properties": {
    "kext": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,48}[a-z0-9]$"
    },
    "version": {
      "type": "string",
      "maxLength": 41,
      "description": "A release version listed in the kext's entry"
    },
    "asset": {
      "type": "string",
      "maxLength": 200
    },
    "result": {
      "enum": [
        "broken",
        "partial",
        "works"
      ]
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "TOML date (YYYY-MM-DD); JSON copies use the ISO string"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "macos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "build"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(1[0-9]|2[0-9])(\\.[0-9]{1,2}){1,2}$"
        },
        "build": {
          "type": "string",
          "pattern": "^[0-9]{2}[A-Z][0-9]{1,4}[a-z]?$"
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "smbios"
      ],
      "properties": {
        "cpu": {
          "type": "string",
          "maxLength": 80
        },
        "smbios": {
          "type": "string",
          "maxLength": 40
        },
        "bootloader": {
          "type": "string",
          "maxLength": 60
        },
        "board": {
          "type": "string",
          "maxLength": 80
        },
        "device_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{4}:[0-9a-f]{4}$"
          },
          "uniqueItems": true,
          "maxItems": 16
        }
      }
    },
    "features": {
      "type": "object",
      "maxProperties": 30,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]{0,30}$"
      },
      "additionalProperties": {
        "enum": [
          "broken",
          "partial",
          "untested",
          "works"
        ]
      }
    }
  }
}
